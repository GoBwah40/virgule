# ─── Base de données ─────────────────────────────────────────────
# Local : fichier SQLite (créé par `pnpm db:migrate`).
DATABASE_URL="file:./dev.db"

# Production (Vercel) : base Turso. Si définies, elles priment sur DATABASE_URL.
# turso db show virgule --url   /   turso db tokens create virgule
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Temps réel (optionnel) ──────────────────────────────────────
# Sans ces variables, l'app se synchronise par polling (toutes les 3 s).
# Offre gratuite Pusher Channels « Sandbox » : https://dashboard.pusher.com
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ─── Purge des rooms expirées ────────────────────────────────────
# Vercel Cron envoie « Authorization: Bearer $CRON_SECRET ».
CRON_SECRET=
