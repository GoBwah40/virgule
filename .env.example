# ─── Database ────────────────────────────────────────────────────
# Local: SQLite file (created by `pnpm db:migrate`).
DATABASE_URL="file:./dev.db"

# Production (Vercel): Turso database. When set, these take precedence over DATABASE_URL.
# turso db show virgule --url   /   turso db tokens create virgule
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Real time (optional) ────────────────────────────────────────
# Without these variables, the app syncs by polling (every 3 s).
# Free Pusher Channels "Sandbox" plan: https://dashboard.pusher.com
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ─── Rate limiting (optional) ────────────────────────────────────
# Without these variables, the same limits apply in memory, per server process (fine locally;
# serverless instances do not share it, so Upstash is recommended in production).
# Free Upstash Redis database: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Scales every quota (default 1), e.g. 100 if you create many rooms while developing.
# Set by the end-to-end tests; never in production.
# RATE_LIMIT_MULTIPLIER=

# ─── Purge of expired rooms ──────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
