{
  "name": "virgule",
  "version": "0.6.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "preprod": "bash scripts/preprod.sh",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "tsx scripts/migrate-turso.mts",
    "db:migrate:preview": "set -a && . ./.env.preview.local && set +a && tsx scripts/migrate-turso.mts",
    "db:reset": "prisma migrate reset",
    "db:reset:remote": "tsx scripts/reset-turso.mts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-storybook": "10.6.0",
    "jsdom": "^30.1.1",
    "jsqr": "^1.4.0",
    "knip": "^6.38.0",
    "prisma": "7.10.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.10.0"
}
