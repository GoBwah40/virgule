// Virgule schema: SQLite locally, Turso (libSQL) in production.
// After a change: `pnpm db:migrate` (local), then `pnpm db:migrate:prod` (Turso).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Phases of a room, driven by the host.
enum Phase {
  THEMES // the host sets the topics
  IDEAS // participants suggest ideas and vote
  RECAP // results of the current round
  CLOSED // session over (read-only)
}

model Room {
  id               String        @id @default(cuid())
  /// Short identifier used in the share link (/r/<slug>).
  slug             String        @unique
  name             String
  phase            Phase         @default(THEMES)
  /// Current round, starts at 1.
  round            Int           @default(1)
  /// Can a participant vote for/against their own ideas?
  allowSelfVote    Boolean       @default(true)
  /// true: an idea is kept if for > against. false: as soon as it has 1 "for" vote.
  requireNetPositive Boolean     @default(true)
  createdAt        DateTime      @default(now())
  expiresAt        DateTime
  // Columns added after creation: at the end of the list so SQLite adds them
  // with ALTER TABLE without rebuilding the table (see CLAUDE.md, additive migrations).
  /// Timer length for the IDEAS phase, in minutes (null = no timer).
  ideasTimerMinutes Int?
  /// End of the running timer (null = no active timer).
  phaseEndsAt      DateTime?
  /// Tiebreak round: only the ideas tied at the top are voted on again, with no new ideas.
  tiebreak         Boolean       @default(false)
  /// Number of seats chosen by the host (null = the default size, see ROOM_SIZES in config.ts).
  maxParticipants  Int?
  /// Room screen pairing: hash of the one-time code shown on the host's phone (null = none).
  screenCodeHash   String?       @unique
  /// End of validity of that code.
  screenCodeExpiresAt DateTime?
  /// Secret of the paired room screen, kept in its cookie (null = no screen). Never exposed.
  screenToken      String?       @unique
  /// The group has seen a recap: from then on, nobody can leave or be removed (their votes
  /// would vanish from results already seen), even after voting is reopened.
  recapSeen        Boolean       @default(false)
  participants     Participant[]
  themes           Theme[]
  ideas            Idea[]
  themeSuggestions ThemeSuggestion[]

  @@index([expiresAt])
}

model Participant {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pseudo    String
  /// Secret stored in an httpOnly cookie, used to reconnect.
  token     String   @unique
  isHost    Boolean  @default(false)
  createdAt DateTime @default(now())
  ideas     Idea[]
  votes     Vote[]
  themeSuggestions ThemeSuggestion[]

  @@unique([roomId, pseudo])
}

/// Kind of answer expected for a topic's ideas.
enum ThemeKind {
  TEXT // free text
  DATE // a date
  DATE_RANGE // a period (from… to…)
  AMOUNT // an amount in euros
  AMOUNT_RANGE // a range of amounts in euros
  PLACE // a place (text, with a link to the map)
  CHOICE // one option from a list set by the host
}

model Theme {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Cannot be changed once ideas exist (they would lose their meaning).
  kind        ThemeKind @default(TEXT)
  position    Int
  createdAt   DateTime @default(now())
  // Columns added after creation (at the end of the list: ALTER TABLE without a rebuild).
  /// CHOICE topics: options set by the host (JSON array of strings).
  options     String?
  /// CHOICE topics: can participants suggest other ideas?
  allowOtherIdeas Boolean @default(false)
  /// CHOICE topics: each participant picks a single option (e.g. yes / no), with no "against" votes.
  singleChoice Boolean @default(false)
  /// Maximum "for" votes per participant in this topic, per round (null = no limit).
  maxVotes    Int?
  ideas       Idea[]

  @@index([roomId, position])
}

/// Topic suggested by a participant during the THEMES phase, waiting for the host to add
/// it (it then becomes a Theme) or dismiss it.
model ThemeSuggestion {
  id          String      @id @default(cuid())
  roomId      String
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Never exposed to the host or the others: only used to show people their own suggestions.
  authorId    String
  author      Participant @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime    @default(now())

  @@index([roomId])
}

model Idea {
  id               String      @id @default(cuid())
  roomId           String
  room             Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  themeId          String
  theme            Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  /// Kept for the self-vote rule; never exposed to other participants.
  authorId         String
  author           Participant @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Idea text (TEXT topics); empty string for typed topics, which are displayed from the fields below.
  /// No default value: adding one would force SQLite to rebuild the table.
  content          String
  /// DATE / DATE_RANGE topics: calendar dates "YYYY-MM-DD" (no time or time zone).
  dateStart        String?
  dateEnd          String?
  /// AMOUNT / AMOUNT_RANGE topics: whole-euro amounts.
  amountMin        Int?
  amountMax        Int?
  /// Round in which the idea was suggested.
  createdRound     Int
  /// First round the idea no longer takes part in (null = still in the running).
  eliminatedRound  Int?
  createdAt        DateTime    @default(now())
  /// Option of a CHOICE topic (created when ideas start): belongs to no one in
  /// particular, so anyone can vote on it and the host can remove it.
  isOption         Boolean     @default(false)
  votes            Vote[]

  @@index([roomId])
  @@index([themeId])
}

model Vote {
  id            String      @id @default(cuid())
  ideaId        String
  idea          Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /// Votes are reset each round: history is kept per round.
  round         Int
  /// true = for, false = against.
  positive      Boolean
  updatedAt     DateTime    @updatedAt

  @@unique([ideaId, participantId, round])
  @@index([participantId])
}
